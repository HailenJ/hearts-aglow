{
  "name": "heartsaglow-stats",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "stats.heartsaglow.io", "custom_domain": true }],
  "assets": { "directory": "./public/", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stats",
      "database_id": "7baf1f82-4d5c-4862-a31a-e753967322b9",
      "migrations_dir": "migrations"
    }
  ],
  // 12:00 UTC = 05:00 MST / 06:00 MDT
  "triggers": { "crons": ["0 12 * * *"] },
  "vars": { "TEAM_DOMAIN": "https://fancy-truth-53ec.cloudflareaccess.com", "POLICY_AUD": "b9d28a87d2185e0629e9ca2321d8c00eb4cd656831e5b343298aecee7e035548", "BSKY_HANDLE": "heartsaglow.io", "GOATCOUNTER_SITE": "heartsaglow" }
}
