{
  "name": "heartsaglow-stats",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "stats.heartsaglow.io", "custom_domain": true }],
  "assets": { "directory": "./public/", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stats",
      "database_id": "REPLACE_WITH_ID_FROM_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],
  // 12:00 UTC = 05:00 MST / 06:00 MDT
  "triggers": { "crons": ["0 12 * * *"] },
  "vars": { "TEAM_DOMAIN": "", "POLICY_AUD": "" }
}
